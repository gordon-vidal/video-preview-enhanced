{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git add *private-context*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "PowerShell(git add *private-context*)",
      "PowerShell(git add -f *)",
      "PowerShell(git add --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/block-visible-launch.js"]
          }
        ]
      }
    ]
  }
}
