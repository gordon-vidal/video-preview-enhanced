# Packages and dependencies
*.vsix
node_modules/

# Editor, agent and OS files
# .claude/: only the shared skills and settings.json are tracked (worktrees and settings.local.json stay out)
.claude/*
!.claude/skills/
!.claude/settings.json
.vscode-test/
.DS_Store
Thumbs.db
*.log

# Maintainer's private notes, local only (docs/private-context.md)
.private-context/

# Git worktrees kept inside the checkout
worktrees/
.worktrees/

# Test outputs and downloads
out/
coverage/
test/vscode/.code/
test/browser/
# generated test clips (test/tracks/make_media.js)
test/media/tracks/
test/media/cases/startup_*
test/media/cases/sp_*
test/media/cases/pb_*
# 1080p clips looped for the 9- and 16-video grids (test/media/make_cases_media.js)
test/media/cases/multiview_*
# Dolby Vision copies of the HDR pattern, made by test/vscode/cases/hdr_output.js (test/zoo/make_dv.js)
test/media/cases/hdr/dv*.mp4

# libav.js build outputs (build/libav/25_mix_build.sh, 32_relink.sh)
build/libav/dist_*/
.lfs-ids

/test/media/.heavy/
# stress clips, several GB (test/media/make_stress_media.js, review.cmd --stress)
/test/media/.stress/
